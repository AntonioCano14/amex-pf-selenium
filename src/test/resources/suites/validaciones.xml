<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  OLA 2: validaciones de campo de Solicitudes (pantalla Expediente), del alta de
  usuario y del detalle del usuario (pantalla Usuarios). Todos los casos son de
  solo lectura: escriben en los campos pero no presionan GUARDAR REGISTRO, GUARDAR
  ni CREAR SOLICITUD.

  Excluye:
  - defecto_conocido    : falla por un defecto abierto de la aplicacion
                          (DEF_02 telefono movil con letras, DEF_04 el detalle no
                          valida los campos obligatorios)
  - regla_por_confirmar : la matriz y la aplicacion no coinciden

  Ejecutar:  mvn test -Dsuite=validaciones
  Con el navegador visible:  mvn test -Dsuite=validaciones -Damex.headless=false
-->
<suite name="Ola 2 - Validaciones de campos AMEX PF" verbose="1" parallel="methods" thread-count="1">

  <test name="Validaciones de campos">
    <groups>
      <run>
        <include name="validaciones"/>
        <exclude name="defecto_conocido"/>
        <exclude name="regla_por_confirmar"/>
      </run>
    </groups>
    <classes>
      <class name="com.amex.pf.pruebas.ValidacionesDeCamposPruebas"/>
      <class name="com.amex.pf.pruebas.UsuariosValidacionesPruebas"/>
      <class name="com.amex.pf.pruebas.UsuariosDetalleValidacionesPruebas"/>
    </classes>
  </test>
</suite>
