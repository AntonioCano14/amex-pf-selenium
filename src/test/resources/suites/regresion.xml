<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Regresion funcional (pruebas de no afectacion).
  Ejecuta todos los casos de solo lectura y excluye:
  - defecto_conocido    : falla por un defecto abierto de la aplicacion
                          (DEF_01 correo con "+", DEF_02 telefono movil con letras,
                          DEF_03 layout de usuarios sin Telefono Fijo)
  - regla_por_confirmar : la matriz y la aplicacion no coinciden
  - escribe_datos       : casos que crean o modifican informacion

  Ejecutar:  mvn test -Dsuite=regresion
-->
<suite name="Regresion AMEX PF - solo lectura" verbose="1" parallel="methods" thread-count="1">

  <test name="Todos los modulos de solo lectura">
    <groups>
      <run>
        <exclude name="defecto_conocido"/>
        <exclude name="regla_por_confirmar"/>
        <exclude name="escribe_datos"/>
      </run>
    </groups>
    <packages>
      <package name="com.amex.pf.pruebas"/>
    </packages>
  </test>
</suite>
