<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Un solo modulo. Copie este archivo y cambie el grupo para tener la suite de
  otro modulo (navegacion, validaciones, catalogos...).
  Ejecutar:  mvn test -Dsuite=login
-->
<suite name="Login AMEX PF" verbose="1">

  <listeners>
    <listener class-name="com.amex.pf.utilidades.EvidenciaListener"/>
    <listener class-name="com.amex.pf.utilidades.ReporteEnConsolaListener"/>
  </listeners>

  <test name="Expediente Login">
    <groups>
      <run>
        <include name="login"/>
        <exclude name="defecto_conocido"/>
      </run>
    </groups>
    <classes>
      <class name="com.amex.pf.pruebas.LoginPruebas"/>
    </classes>
  </test>
</suite>
